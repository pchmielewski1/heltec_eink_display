#pragma once

// Copy this file to `include/secrets.h` and fill in your values.

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

#define MQTT_HOST "YOUR_MQTT_HOST"
#define MQTT_PORT 1883

// PubSubClient default buffer is small (~256B). Increase to handle JSON payloads.
#define MQTT_BUFFER_SIZE 2048

#define MQTT_USERNAME ""
#define MQTT_PASSWORD ""

#define MQTT_SUBSCRIBE_TOPIC ""
#define MQTT_DEVICE_NAME "Env Display"

// JSON field mapping (optional)
// If your payload uses different names (e.g. temperature_c instead of temperature),
// set the keys below.
// Supported JSON shapes:
//   {"temperature": 23.5, "barometric_pressure": 993.2, "relative_humidity": 55.0}
//   {"payload": {...}}  (same keys under "payload")
#define JSON_TEMP_KEY "temperature"
#define JSON_PRESSURE_KEY "barometric_pressure"
#define JSON_HUMIDITY_KEY "relative_humidity"

#define DISPLAY_MIN_REFRESH_MS 15000
#define DISPLAY_PERIODIC_REFRESH_MS 0

// Adaptive deep sleep (v1)
// Set to 1 to enable deep sleep scheduling based on learned cadence.
#define DEEPSLEEP_ENABLE 0
#define DEEPSLEEP_LEARN_ENABLE 1
#define DEEPSLEEP_MIN_SEC 60
#define DEEPSLEEP_MAX_SEC 1800
#define DEEPSLEEP_LISTEN_WINDOW_SEC 90
#define DEEPSLEEP_FALLBACK_SEC 300
#define DEEPSLEEP_CONFIDENCE_MIN 45
// For slow streams (e.g. mapped updates every 30-45 minutes), consider:
// - raising DEEPSLEEP_MAX_SEC (e.g. 5400)
// - raising DEEPSLEEP_FALLBACK_SEC (e.g. 1800)
// - lowering DEEPSLEEP_CONFIDENCE_MIN (e.g. 16)
// Device will not sleep until this many environmental cadence intervals are learned.
// Default 2 means sleep can start after about 3 environmental updates.
#define DEEPSLEEP_MIN_INTERVAL_SAMPLES 2
// Ignore shorter intervals during learning (filters burst/companion messages).
#define DEEPSLEEP_LEARN_MIN_INTERVAL_SEC 120

// Retained mode override (optional):
// - when topic payload is "retain_poll_15m", adaptive learning is paused
//   and firmware wakes in fixed polling loop.
// - when topic payload is "adaptive" (or retained flag is deleted),
//   firmware resets learning and starts adaptive training from scratch.
// Leave empty string to disable broker mode override.
#define DEEPSLEEP_RETAIN_MODE_TOPIC ""
#define DEEPSLEEP_RETAIN_POLL_SEC 900

// Safety guards against too-fast deep-sleep loops:
// minimum awake time before sleep decision and max consecutive empty sleep cycles.
#define DEEPSLEEP_MIN_AWAKE_SEC 30
#define DEEPSLEEP_MAX_EMPTY_SLEEP_CYCLES 12

// Battery (Heltec Wireless Paper v1.x)
// VBAT measurement path on Wireless Paper (no extra wiring):
// - VBAT measurement is on ADC2 GPIO20
// - divider/measurement path is controlled by GPIO19 (active LOW)
// If BAT shows --% or bogus values, your hardware revision may differ
// and the values below should be adjusted.
#define BATTERY_ADC_PIN 20
// Control pin that enables divider/measurement path (optional).
#define BATTERY_ADC_CTRL_PIN 19
#define BATTERY_ADC_CTRL_ENABLED LOW

// Multiplier from ADC input voltage to VBAT.
// This is NOT a fixed magic value — it depends on board resistor divider,
// component tolerances, and ADC mV conversion behavior.
//
// How to calibrate (simple battery method):
// 1) On working firmware, read voltage shown on screen (V_fw).
// 2) At the same time, measure battery voltage with a multimeter (V_real).
// 3) Compute new multiplier:
//      BATTERY_DIVIDER_new = BATTERY_DIVIDER_old * (V_real / V_fw)
#define BATTERY_DIVIDER 2.0
// Attenuation: IDF uses "12dB"; in Arduino this corresponds to ADC_11db.
#define BATTERY_ADC_ATTENUATION ADC_11db

// Voltage-to-percent mapping (rough; tune to your battery chemistry/preferences).
#define BATTERY_V_EMPTY 3.3
#define BATTERY_V_FULL 4.2

// Optional sanity bounds to reject bogus reads.
#define BATTERY_MIN_VALID_V 2.8
#define BATTERY_MAX_VALID_V 4.5
