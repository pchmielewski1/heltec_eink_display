#pragma once

// Copy this file to `include/secrets.h` and fill in your values.

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

#define MQTT_HOST "YOUR_MQTT_HOST"
#define MQTT_PORT 1883

// PubSubClient default buffer is small (~256B). Increase to handle JSON payloads.
#define MQTT_BUFFER_SIZE 2048

#define MQTT_USERNAME ""
#define MQTT_PASSWORD ""

#define MQTT_SUBSCRIBE_TOPIC ""
#define MQTT_DEVICE_NAME "Env Display"

// JSON field mapping (optional)
// If your payload uses different names (e.g. temperature_c instead of temperature),
// set the keys below.
// Supported JSON shapes:
//   {"temperature": 23.5, "barometric_pressure": 993.2, "relative_humidity": 55.0}
//   {"payload": {...}}  (same keys under "payload")
#define JSON_TEMP_KEY "temperature"
#define JSON_PRESSURE_KEY "barometric_pressure"
#define JSON_HUMIDITY_KEY "relative_humidity"

#define DISPLAY_MIN_REFRESH_MS 15000
#define DISPLAY_PERIODIC_REFRESH_MS 0

// Battery (Heltec Wireless Paper v1.x)
// Tor pomiaru VBAT w Wireless Paper (bez dodatkowych przewodów):
// - pomiar VBAT jest na ADC2 GPIO20
// - dzielnik/pomiar jest sterowany pinem GPIO19 (aktywny stan LOW)
// Jeśli BAT pokazuje --% lub głupoty, skoryguj poniższe wartości.
#define BATTERY_ADC_PIN 20
// Pin sterujący włączeniem dzielnika/pomiaru (opcjonalny).
#define BATTERY_ADC_CTRL_PIN 19
#define BATTERY_ADC_CTRL_ENABLED LOW

// Mnożnik z napięcia na wejściu ADC do VBAT.
// To NIE jest „magiczna” stała — zależy od dzielnika rezystorowego na płytce,
// tolerancji elementów i tego jak ADC przelicza na mV.
//
// Jak skalibrować (najprościej, pod baterię):
// 1) Odczytaj napięcie pokazane na ekranie (V_fw).
// 2) Zmierz równocześnie napięcie baterii multimetrem (V_real).
// 3) Przelicz nowy mnożnik:
//      BATTERY_DIVIDER_new = BATTERY_DIVIDER_old * (V_real / V_fw)
#define BATTERY_DIVIDER 2.0
// Attenuation: IDF ma "12dB"; w Arduino odpowiada temu ADC_11db.
#define BATTERY_ADC_ATTENUATION ADC_11db

// Voltage-to-percent mapping (rough; tune to your battery chemistry/preferences).
#define BATTERY_V_EMPTY 3.3
#define BATTERY_V_FULL 4.2

// Optional sanity bounds to reject bogus reads.
#define BATTERY_MIN_VALID_V 2.8
#define BATTERY_MAX_VALID_V 4.5
